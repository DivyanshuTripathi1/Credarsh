# Server Port (injected automatically on platforms like Render, Heroku, Railway)
PORT=3002

# Runtime environment (development | production)
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/zerodha?retryWrites=true&w=majority

# Allowed Frontend Client URLs for CORS and session cookies
FRONTEND_URL=https://your-frontend.vercel.app
DASHBOARD_URL=https://your-dashboard.vercel.app

# Additional allowed origins (comma-separated, optional)
ALLOWED_ORIGINS=
